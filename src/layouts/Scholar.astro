---
import site from "../site.config";
import { rubricSlug } from "../site.config";
const { title, description = site.tagline, image = site.heroImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(location.hostname.indexOf("www.")!==0){location.replace(location.href.replace("://","://www."));}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style is:global>
      body { font-family: "Inter", system-ui, sans-serif; }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-800">
    <header class="mx-auto max-w-3xl px-5 pb-6 pt-12">
      <a href="/" class="font-serif text-3xl font-bold text-indigo-900">{site.name}</a>
      <p class="mt-1 text-sm text-slate-500">{site.tagline}</p>
      <nav class="mt-6 flex flex-wrap gap-5 text-sm font-medium">
        <a href="/" class="hover:text-indigo-700">Start</a>
        <a href="/blog" class="hover:text-indigo-700">Artykuły</a>
        <a href="/dzialy" class="hover:text-indigo-700">Działy</a>
        <a href="/o-nas" class="hover:text-indigo-700">O nas</a>
        <a href="/kontakt" class="hover:text-indigo-700">Kontakt</a>
      </nav>
      <hr class="mt-6 border-slate-200" />
    </header>
    <slot />
    <footer class="mx-auto max-w-3xl border-t border-slate-200 px-5 py-10 text-center text-xs text-slate-500">
      <p class="text-sm text-slate-700">{site.address}</p>
      <p class="mt-2"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p class="mt-3">
        {site.rubrics.map((r, i) => (
          <>
            {i > 0 && " · "}
            <a href={`/dzialy/${rubricSlug(r.name)}`}>{r.name}</a>
          </>
        ))}
      </p>
      <p class="mt-3"><a href="/polityka-prywatnosci">Prywatność</a> · <a href="/regulamin">Regulamin</a></p>
      <p class="mt-2">© {new Date().getFullYear()} {site.name}, Gdańsk</p>
    </footer>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"164553a21e1945709efc08eede2d6f8c"}'></script>
  </body>
</html>
