---
import Scholar from "../../layouts/Scholar.astro";
import { getCollection } from "astro:content";
import site, { rubricSlug } from "../../site.config";
const posts = await getCollection("blog");
const cats = [...new Set(posts.map((p) => p.data.category).filter(Boolean))] as string[];
---
<Scholar title="Działy" description="Działy tematyczne Jestem Edu.">
  <main class="mx-auto max-w-3xl px-5 pb-16">
    <h1 class="font-serif text-3xl">Działy</h1>
    <ul class="mt-8 space-y-6">
      {cats.map((cat) => (
        <li class="border-b border-slate-200 pb-4">
          <a href={`/dzialy/${rubricSlug(cat)}`} class="font-serif text-2xl text-indigo-800 hover:underline">{cat}</a>
          <p class="mt-1 text-sm text-slate-500">{posts.filter((p) => p.data.category === cat).length} artykułów</p>
        </li>
      ))}
    </ul>
  </main>
</Scholar>
