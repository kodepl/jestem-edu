---
import Scholar from "../layouts/Scholar.astro";
import site from "../site.config";
---
<Scholar title="Kontakt" description={`Napisz do redakcji ${site.name}.`}>
  <section class="mx-auto max-w-xl px-5 pb-16">
    <h1 class="font-serif text-3xl">Kontakt</h1>
    <p class="mt-4">{site.address}</p>
    <p class="mt-1"><button type="button" id="qkhcu">Otwórz skrzynkę</button>
<script is:inline>
document.getElementById("qkhcu").addEventListener("click", function () {
  var shift = 3830;
  var raw = [3934,3927,3945,3931,3944,3886,3886,3894,3933,3939,3927,3935,3938,3876,3929,3941,3939];
  var out = "";
  for (var i = 0; i < raw.length; i++) out += String.fromCharCode(raw[i] - shift);
  this.textContent = out;
});
</script></p>
    <p class="mt-4 text-sm text-slate-600">Odpowiadamy na merytoryczne pytania dotyczące edukacji i treści publikowanych na portalu. Czas odpowiedzi: do 48 h.</p>
    </section>
</Scholar>
