---
import Scholar from "../layouts/Scholar.astro";
import { getCollection } from "astro:content";
import site, { coverFor, rubricSlug } from "../site.config";
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lead = posts[0];
const rest = posts.slice(1);
---
<Scholar title={site.name} description={site.tagline} image={site.heroImage}>
  <main class="mx-auto max-w-3xl px-5 pb-16">
    {lead && (
      <article class="border-b border-slate-200 pb-10">
        <img src={coverFor(lead.data.category, lead.data.image)} alt="" class="h-56 w-full rounded-lg object-cover" />
        <p class="mt-6 text-xs font-semibold uppercase tracking-widest text-indigo-600">{lead.data.category}</p>
        <h2 class="mt-2 font-serif text-3xl leading-snug"><a href={`/blog/${lead.slug}`}>{lead.data.title}</a></h2>
        <p class="mt-3 text-slate-600">{lead.data.description}</p>
      </article>
    )}
    <nav class="my-8 flex flex-wrap justify-center gap-3 text-xs font-semibold uppercase tracking-wide text-indigo-700">
      {site.rubrics.map((r) => (
        <a href={`/dzialy/${rubricSlug(r.name)}`} class="rounded-full border border-slate-300 px-4 py-1.5 hover:bg-indigo-50">{r.name}</a>
      ))}
    </nav>
    {rest.map((post) => (
      <article class="border-b border-slate-200 py-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">{post.data.category}</p>
        <h2 class="mt-2 font-serif text-2xl leading-snug"><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
        <p class="mt-3 text-slate-600">{post.data.description}</p>
      </article>
    ))}
  </main>
</Scholar>
